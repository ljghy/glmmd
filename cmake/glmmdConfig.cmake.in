@PACKAGE_INIT@

include(CMakeFindDependencyMacro)

find_dependency(glm)

if(@GLMMD_USE_TBB@)
    find_dependency(TBB)
endif()

if(@GLMMD_USE_BULLET@)
    find_dependency(Bullet)
endif()

if(@GLMMD_USE_ICU@)
    find_dependency(ICU COMPONENTS uc)
endif()

include("${CMAKE_CURRENT_LIST_DIR}/glmmdTargets.cmake")

check_required_components(glmmd)
